# Copy this file to .env and fill in the keys for the providers you want to
# exercise. lab.sh and pipeline.sh read this file (override with ENV_FILE;
# default is ./.env), hand each key to the container by name, and never print
# a value. A provider whose key is absent is simply not called: pass --models
# (MODELS=) with the ids you have keys for.
#
# Up to five providers are supported out of the box; add or change models in
# lab/models.json.

# Anthropic (Claude). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI, and any OpenAI-compatible Chat Completions endpoint.
# https://platform.openai.com/
OPENAI_API_KEY=

# Google (Gemini). https://aistudio.google.com/
GOOGLE_API_KEY=

# Alibaba Cloud Model Studio (Qwen), international endpoint.
# https://www.alibabacloud.com/help/en/model-studio/
QWEN_API_KEY=

# OpenRouter's API key, used when running models of the `openrouter` provider
# (OpenRouter is an OpenAI-compatible gateway to many providers' models).
# https://openrouter.ai/ . The public price lookup `discover` uses needs no key.
OPENROUTER_API_KEY=
